# Reverse proxy (Caddy) — production only; unused for local HTTP on :80
DOMAIN=api.example.com

# Node API (nba-analytics-hub)
NODE_ENV=development
GAMES_SERVICE_URL=http://go-feed:4000
PREDICTOR_SERVICE_URL=http://predictor:5000

# Go feed (nba-data-service)
PROVIDER=balldontlie
BALLDONTLIE_BASE_URL=https://api.balldontlie.io/v1
BALLDONTLIE_API_KEY=your_api_key_here
BALLDONTLIE_TIMEZONE=America/New_York

# Predictor (nba-predictor) — production/desktop volume overrides, optional
PREDICTOR_DATA_CACHE=/path/to/data_cache
PREDICTOR_ARTIFACTS=/path/to/artifacts
